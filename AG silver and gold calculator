</div>

<div id="reportOverlay">
  <div style="width:100%;">
    <div class="report-actions">
      <button onclick="downloadReportPDF()">⬇ Download PDF</button>
      <button onclick="downloadReportHTML()">⬇ Download HTML</button>
      <button class="close" onclick="closeReport()">Close</button>
    </div>
    <div class="report-card" id="reportCard"></div>
  </div>
</div>

