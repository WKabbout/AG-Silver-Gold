<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AG Silver and Gold — Price List</title>
<style>
:root{ --gold:#c9a227; --gold-dark:#8a6d1a; --ink:#1c1c1c; --paper:#fbf9f4; --line:#e4ddc9; }
*{box-sizing:border-box;}
body{margin:0;font-family:Georgia,'Times New Roman',serif;background:#111;color:var(--ink);}
.watermark{position:fixed;inset:0;background-image:url('data:image/png;base64,');background-repeat:no-repeat;background-position:center 40%;background-size:min(70vw,600px);opacity:.06;pointer-events:none;z-index:0;}
.page{position:relative;z-index:1;max-width:980px;margin:0 auto;background:var(--paper);min-height:100vh;box-shadow:0 0 40px rgba(0,0,0,.5);}
header.top{display:flex;align-items:center;justify-content:center;gap:22px;padding:28px 20px 18px;border-bottom:3px solid var(--gold);}
header.top img{height:78px;}
header.top .biz h1{margin:0;font-size:1.5rem;letter-spacing:1px;color:var(--gold-dark);}
header.top .biz p{margin:2px 0 0;font-size:.75rem;color:#666;}
.board{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;padding:16px 20px;background:#161616;}
.board .card{background:#232323;border:1px solid #3a3a3a;border-radius:10px;padding:10px 18px;color:#eee;text-align:center;min-width:150px;}
.board .card.gold{border-color:#6b5619;}
.board .card b{display:block;font-size:1.25rem;color:var(--gold);margin:4px 0;}
.board .card.silver b{color:#cfd3d6;}
.board button{margin-top:4px;background:none;border:1px solid #666;color:#ddd;border-radius:14px;font-size:.65rem;padding:3px 10px;cursor:pointer;}
.board button:hover{background:#fff;color:#111;}
.board small{display:block;color:#888;font-size:.62rem;margin-top:2px;min-height:12px;}

.controls{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:center;padding:14px 20px;background:#f1ead2;border-bottom:1px solid var(--line);}
.controls label{font-size:.72rem;color:#555;display:flex;flex-direction:column;gap:2px;}
.controls input{width:92px;padding:4px 6px;border:1px solid #bbb;border-radius:4px;font-size:.8rem;}
.controls button.action{background:var(--gold-dark);color:#fff;border:none;padding:8px 16px;border-radius:6px;cursor:pointer;font-size:.78rem;letter-spacing:.5px;align-self:flex-end;}
.controls button.action:hover{background:#6f5814;}
.controls button.toggle{background:#333;}

.section-title{text-align:center;font-size:1.3rem;letter-spacing:3px;padding:18px 0 6px;color:var(--gold-dark);}
table.report{width:100%;border-collapse:collapse;font-size:.85rem;}
table.report th{background:var(--gold-dark);color:#fff;padding:8px 6px;font-size:.72rem;letter-spacing:.5px;text-transform:uppercase;}
table.report td{padding:7px 6px;border-bottom:1px solid var(--line);}
table.report tbody tr:nth-child(even){background:#f4efdd;}
.photo-ph{width:34px;height:34px;border:1.5px dashed #b8ae8c;border-radius:5px;background:#fff8;display:inline-block;}
.buy{color:#1a6b2e;font-weight:bold;}
.sell{color:#a12626;font-weight:bold;}
.item-name{font-weight:600;}
.edit-toggle{cursor:pointer;color:#8a6d1a;font-size:.68rem;text-decoration:underline;background:none;border:none;padding:0;}
tr.edit-row td{background:#fffbe9;padding:10px 12px;}
.edit-grid{display:flex;flex-wrap:wrap;gap:10px;}
.edit-grid label{font-size:.68rem;color:#555;display:flex;flex-direction:column;gap:2px;}
.edit-grid input{width:78px;padding:3px 5px;border:1px solid #ccc;border-radius:4px;font-size:.78rem;}
.scrap-title{background:#eadfb8 !important;font-weight:bold;text-align:center;letter-spacing:1px;font-size:.75rem;}
footer.site{text-align:center;padding:20px;font-size:.7rem;color:#777;border-top:1px solid var(--line);}
.note{font-size:.68rem;color:#888;text-align:center;padding:4px 20px;}

/* ---- Printable branded report card ---- */
#reportOverlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:50;overflow:auto;padding:24px 10px;}
#reportOverlay.open{display:flex;justify-content:center;align-items:flex-start;}
.report-actions{position:sticky;top:0;display:flex;gap:10px;justify-content:center;padding:10px;background:rgba(0,0,0,.4);z-index:2;}
.report-actions button{background:#c9a227;border:none;color:#111;font-weight:bold;padding:8px 16px;border-radius:6px;cursor:pointer;font-size:.8rem;}
.report-actions button.close{background:#555;color:#fff;}
.report-card{width:100%;max-width:620px;margin:56px auto 20px;background:radial-gradient(circle at 50% 0%,#1a1a1a,#000);border:4px solid #c9a227;border-radius:16px;box-shadow:0 0 0 2px #6b5619,0 0 30px 4px rgba(201,162,39,.55);padding:18px 16px 26px;font-family:Georgia,serif;color:#fff;}
.rc-header{text-align:center;margin-bottom:10px;}
.rc-header img{height:60px;display:block;margin:0 auto 4px;}
.rc-header .rc-name{font-size:1.4rem;font-weight:bold;letter-spacing:2px;background:linear-gradient(180deg,#fff6d0,#c9a227 60%,#8a6d1a);-webkit-background-clip:text;background-clip:text;color:transparent;}
.rc-header .rc-sub{font-size:.65rem;letter-spacing:4px;color:#d8c48a;margin-top:2px;}
.rc-metal-bar{display:flex;align-items:center;justify-content:space-between;background:linear-gradient(180deg,#2b2b2b,#111);border:2px solid #c9a227;border-radius:10px;padding:6px 14px;margin:14px 0 0;}
.rc-metal-bar .rc-metal-name{font-size:1.3rem;font-weight:bold;letter-spacing:1px;color:#f2d879;}
.rc-metal-bar.silver .rc-metal-name{color:#e7e9eb;}
.rc-spot-badge{background:#111;border:2px solid #c9a227;color:#f2d879;border-radius:8px;padding:4px 12px;font-weight:bold;font-size:1.1rem;}
.rc-metal-bar.silver .rc-spot-badge{color:#e7e9eb;border-color:#9aa0a6;}
table.rc-table{width:100%;border-collapse:collapse;background:#f4efdd;border-radius:0 0 8px 8px;overflow:hidden;font-size:.8rem;margin-bottom:2px;}
table.rc-table th{background:#c9a227;color:#111;padding:6px 4px;font-size:.68rem;text-transform:uppercase;}
table.rc-table th.buy{background:#1a6b2e;color:#fff;}
table.rc-table th.sell{background:#a12626;color:#fff;}
table.rc-table td{padding:4px 6px;color:#1c3a63;font-weight:600;border-bottom:1px solid #e4ddc9;background:#fbf9f4;}
table.rc-table tr:nth-child(even) td{background:#f1ead2;}
table.rc-table td.rc-buy,table.rc-table td.rc-sell{color:#1c3a63;font-weight:bold;text-align:center;}
.rc-scrap{background:#f3ddb8;padding:6px 10px;font-size:.78rem;}
.rc-scrap.silver{background:#d8ecd8;}
.rc-scrap-row{display:flex;justify-content:space-between;padding:2px 4px;}
.rc-scrap-row .lbl{color:#333;}
.rc-scrap-row .val{color:#a12626;font-weight:bold;}
@media print{
  body *{visibility:hidden;}
  #reportOverlay, #reportOverlay *{visibility:visible;}
  #reportOverlay{position:absolute;inset:0;background:#fff;padding:0;}
  .report-actions{display:none;}
  .report-card{box-shadow:none;margin:0 auto;}
}
</style>
</head>
