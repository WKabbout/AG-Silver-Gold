<script>
const DATA = JSON.parse(document.getElementById('price-data').textContent);
const GOLD_HEADERS = DATA.gold_headers, SILVER_HEADERS = DATA.silver_headers;

// Global rows store: coord-key -> current value
const ROWS = {};
function initRows(items){
  items.forEach(it=>{ it.editable.forEach(f=>{ ROWS[f.key] = f.value; }); });
}
initRows(DATA.gold_items); initRows(DATA.gold_scrap);
initRows(DATA.silver_items); initRows(DATA.silver_scrap);

const STATE = {
  GOLD_SPOT: DATA.gold_spot,
  COMM_WATANE: DATA.gold_commissions.watane,
  COMM_VAL: DATA.gold_commissions.val,
  COMM_RAMLI: DATA.gold_commissions.ramli,
  COMM_RAMLE_MKT: DATA.gold_commissions.ramle_mkt,
  SILVER_SPOT: DATA.silver_spot,
  swapped: false
};

document.getElementById('goldSpot').value = STATE.GOLD_SPOT;
document.getElementById('commWatane').value = STATE.COMM_WATANE;
document.getElementById('commVal').value = STATE.COMM_VAL;
document.getElementById('commRamli').value = STATE.COMM_RAMLI;
document.getElementById('silverSpot').value = STATE.SILVER_SPOT;

function compileItem(it){
  it._fn = new Function('GOLD_SPOT','COMM_WATANE','COMM_VAL','COMM_RAMLI','COMM_RAMLE_MKT','SILVER_SPOT','R',
    'return {sell: ('+it.sell_expr+'), buy: ('+it.buy_expr+')};');
}
[...DATA.gold_items, ...DATA.gold_scrap, ...DATA.silver_items, ...DATA.silver_scrap].forEach(compileItem);

function evalItem(it){
  try{
    return it._fn(STATE.GOLD_SPOT, STATE.COMM_WATANE, STATE.COMM_VAL, STATE.COMM_RAMLI, STATE.COMM_RAMLE_MKT, STATE.SILVER_SPOT, ROWS);
  }catch(e){ return {sell:NaN, buy:NaN}; }
}

function headerFor(metal, col){
  const h = metal==='gold' ? GOLD_HEADERS : SILVER_HEADERS;
  return h[col] || col;
}

function fmt(n){ return isNaN(n) ? '—' : Number(n).toLocaleString(undefined,{maximumFractionDigits:3}); }

function renderRow(it, metal, isScrap){
  const r = evalItem(it);
  let buy = r.buy, sell = r.sell;
  if(STATE.swapped){ const t=buy; buy=sell; sell=t; }
  const rid = metal+'_'+it.row;
  const editFields = it.editable.map(f=>{
    const label = headerFor(metal, f.col);
    return `<label>${label} (${f.col})<input type="number" step="any" data-key="${f.key}" data-rid="${rid}" value="${ROWS[f.key]}"></label>`;
  }).join('');
  return `
  <tr class="${isScrap?'scrap-item':''}">
    <td>${isScrap?'':'<span class="photo-ph"></span>'}</td>
    <td class="item-name">${it.item}</td>
    <td class="buy">${fmt(buy)}</td>
    <td class="sell">${fmt(sell)}</td>
    <td><button class="edit-toggle" onclick="toggleEdit('${rid}')">adjust ▾</button></td>
  </tr>
  <tr class="edit-row" id="edit-${rid}" style="display:none"><td colspan="5"><div class="edit-grid">${editFields}</div></td></tr>`;
}

function renderAll(){
  const gb = document.getElementById('goldBody');
  gb.innerHTML = DATA.gold_items.map(it=>renderRow(it,'gold',false)).join('') +
    '<tr><td colspan="5" class="scrap-title">GOLD SCRAP (كسر)</td></tr>' +
    DATA.gold_scrap.map(it=>renderRow(it,'gold',true)).join('');
  const sb = document.getElementById('silverBody');
  sb.innerHTML = DATA.silver_items.map(it=>renderRow(it,'silver',false)).join('') +
    '<tr><td colspan="5" class="scrap-title">SILVER SCRAP / PURITY (كسر)</td></tr>' +
    DATA.silver_scrap.map(it=>renderRow(it,'silver',true)).join('');
  attachEditListeners();
}

function attachEditListeners(){
  document.querySelectorAll('.edit-grid input').forEach(inp=>{
    inp.addEventListener('change', e=>{
      const key = e.target.getAttribute('data-key');
      ROWS[key] = parseFloat(e.target.value);
      renderAll();
      const rid = e.target.getAttribute('data-rid');
      document.getElementById('edit-'+rid).style.display='table-row';
    });
  });
}

function toggleEdit(rid){
  const row = document.getElementById('edit-'+rid);
  row.style.display = (row.style.display==='none') ? 'table-row' : 'none';
}

function recomputeAll(){
  STATE.GOLD_SPOT = parseFloat(document.getElementById('goldSpot').value);
  STATE.COMM_WATANE = parseFloat(document.getElementById('commWatane').value);
  STATE.COMM_VAL = parseFloat(document.getElementById('commVal').value);
  STATE.COMM_RAMLI = parseFloat(document.getElementById('commRamli').value);
  STATE.SILVER_SPOT = parseFloat(document.getElementById('silverSpot').value);
  renderAll();
}

function toggleSwap(){
  STATE.swapped = !STATE.swapped;
  document.getElementById('swapNote').style.display = STATE.swapped ? 'block' : 'none';
  renderAll();
}

let REPORT_SWAPPED = false;

function priceCell(it){
  const r = evalItem(it);
  let buy = r.buy, sell = r.sell;
  if(REPORT_SWAPPED){ const t=buy; buy=sell; sell=t; }
  return {buy, sell};
}

function buildReportCard(){
  const goldRows = DATA.gold_items.map(it=>{
    const p = priceCell(it);
    return `<tr><td>${it.item}</td><td class="rc-buy">${fmt(p.buy)}</td><td class="rc-sell">${fmt(p.sell)}</td></tr>`;
  }).join('');
  const silverRows = DATA.silver_items.map(it=>{
    const p = priceCell(it);
    return `<tr><td>${it.item}</td><td class="rc-buy">${fmt(p.buy)}</td><td class="rc-sell">${fmt(p.sell)}</td></tr>`;
  }).join('');
  const goldScrap = DATA.gold_scrap.map(it=>{
    const p = priceCell(it);
    const shown = REPORT_SWAPPED ? p.buy : p.sell;
    return `<div class="rc-scrap-row"><span class="lbl">${it.item}</span><span class="val">${fmt(shown)}</span></div>`;
  }).join('');
  const silverScrap = DATA.silver_scrap.map(it=>{
    const p = priceCell(it);
    const shown = REPORT_SWAPPED ? p.buy : p.sell;
    return `<div class="rc-scrap-row"><span class="lbl">${it.item}</span><span class="val">${fmt(shown)}</span></div>`;
  }).join('');

  return `
  <div class="rc-header">
    <img src="${document.querySelector('header.top img').src}" alt="logo">
    <div class="rc-name">SILVER AND GOLD</div>
    <div class="rc-sub">PREMIUM QUALITY</div>
  </div>
  <div class="rc-metal-bar gold"><span class="rc-metal-name">GOLD</span><span class="rc-spot-badge">${fmt(STATE.GOLD_SPOT)}</span></div>
  <table class="rc-table">
    <thead><tr><th>Item</th><th class="buy">Buy</th><th class="sell">Sell</th></tr></thead>
    <tbody>${goldRows}</tbody>
  </table>
  <div class="rc-scrap">${goldScrap}</div>
  <div class="rc-metal-bar silver"><span class="rc-metal-name">SILVER</span><span class="rc-spot-badge">${fmt(STATE.SILVER_SPOT)}</span></div>
  <table class="rc-table">
    <thead><tr><th>Item</th><th class="buy">Buy</th><th class="sell">Sell</th></tr></thead>
    <tbody>${silverRows}</tbody>
  </table>
  <div class="rc-scrap silver">${silverScrap}</div>
  `;
}

function generateReport(){
  REPORT_SWAPPED = !REPORT_SWAPPED;
  document.getElementById('reportCard').innerHTML = buildReportCard();
  document.getElementById('reportOverlay').classList.add('open');
}
function closeReport(){
  document.getElementById('reportOverlay').classList.remove('open');
}
async function downloadReportPDF(){
  const node = document.getElementById('reportCard');
  const canvas = await html2canvas(node, {backgroundColor:'#000', scale:2});
  const img = canvas.toDataURL('image/png');
  const { jsPDF } = window.jspdf;
  const pdf = new jsPDF({unit:'px', format:[canvas.width, canvas.height]});
  pdf.addImage(img, 'PNG', 0, 0, canvas.width, canvas.height);
  pdf.save('AG_Price_List_' + new Date().toISOString().slice(0,10) + '.pdf');
}
function downloadReportHTML(){
  const card = document.getElementById('reportCard').outerHTML;
  const styles = Array.from(document.querySelectorAll('style')).map(s=>s.outerHTML).join('\n');
  const doc = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>AG Price List</title>${styles}
  <style>body{background:#000;display:flex;justify-content:center;padding:30px 0;}</style></head><body>${card}</body></html>`;
  const blob = new Blob([doc], {type:'text/html'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'AG_Price_List_' + new Date().toISOString().slice(0,10) + '.html';
  a.click();
}

async function fetchLive(symbol){
  const el = document.getElementById(symbol.toLowerCase()+'Live');
  const t = document.getElementById(symbol.toLowerCase()+'LiveTime');
  el.textContent='…';
  try{
    const res = await fetch('https://api.gold-api.com/price/'+symbol);
    if(!res.ok) throw new Error();
    const d = await res.json();
    el.textContent = '$'+Number(d.price).toLocaleString(undefined,{maximumFractionDigits:2});
    t.textContent = new Date(d.updatedAt).toLocaleTimeString();
    // Push the live price straight into the base price used across the whole report,
    // the same way the Excel refresh button overwrites B4 — then recalculate everything.
    if(symbol === 'XAU'){
      document.getElementById('goldSpot').value = d.price;
      STATE.GOLD_SPOT = d.price;
    } else if(symbol === 'XAG'){
      document.getElementById('silverSpot').value = d.price;
      STATE.SILVER_SPOT = d.price;
    }
    renderAll();
  }catch(e){
    el.textContent='—';
    t.textContent = (e && e.message) ? e.message : 'fetch failed';
    console.error('Live price fetch failed for', symbol, e);
  }
}

renderAll();
</script>
</body>
</html>
